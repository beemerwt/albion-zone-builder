{
  "name": "albion-zone-builder-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:staged": "lint-staged",
    "wasm:build": "cd wasm-map-bounds && wasm-pack build --target web --out-dir ../src/wasm/map-bounds",
    "wasm:test": "cd wasm-map-bounds && cargo test",
    "wasm:clean": "rm -rf src/wasm/map-bounds/wasm_map_bounds* src/wasm/map-bounds/*.wasm node_modules/.vite"
  },
  "dependencies": {
    "@techstark/opencv-js": "^4.12.0-release.1",
    "bootstrap": "^5.3.3",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.4",
    "react-dom": "^18.3.1",
    "react-select": "^5.8.0",
    "react-zoom-pan-pinch": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.6",
    "prettier": "3.6.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,html,md,yml,yaml}": "prettier --write"
  }
}
